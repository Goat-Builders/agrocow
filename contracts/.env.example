# Copiar a contracts/.env (está en .gitignore). NUNCA commitear claves.
# Solo redes de prueba: scripts/deploy.js rechaza cualquier otra.

# Clave de una cuenta de PRUEBA, sin fondos reales
DEPLOYER_PRIVATE_KEY=

AMOY_RPC_URL=https://rpc-amoy.polygon.technology
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# USDC de prueba de Circle en la red elegida (verificar la dirección en la documentación de Circle)
USDC_ADDRESS=

# Cuenta del backend (firma atestaciones) y del veterinario. Si se omiten, se usa la del deployer.
ORACLE_ADDRESS=
VET_ADDRESS=
