{
  "name": "agrocow-contracts",
  "private": true,
  "version": "0.1.0",
  "description": "Contratos de ejemplo de AgroCow (NFT por vaca + escrow de pagos en USDC). Solo testnet.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:arbitrumSepolia": "hardhat run scripts/deploy.js --network arbitrumSepolia",
    "export-abi": "node scripts/export-abi.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.29.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^16.6.1"
  }
}
